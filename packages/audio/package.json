{
  "name": "@helix/audio",
  "version": "0.0.0",
  "description": "Audio engine and utilities for Helix mobile video editor",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly --outDir dist --declarationDir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "audio",
    "web-audio-api",
    "audio-editor",
    "wasm",
    "mobile"
  ],
  "author": "Helix Team",
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "react": "^19.2.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
